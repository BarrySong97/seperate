# Cloudflare R2 credentials for `pnpm upload` (scripts/upload-media.mjs).
#   cp .env.example .env    (.env is gitignored)
# Cloudflare dashboard → R2 → Manage R2 API Tokens → create an Access Key.

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Public base URL of the bucket, no trailing slash: a custom domain or https://pub-xxxx.r2.dev
R2_PUBLIC_BASE=

# Folder inside the bucket for this site's media
R2_KEY_PREFIX=seperate
